generator client {
  provider      = "prisma-client-js"
  // node:20-alpine's Alpine base ships OpenSSL 3.x only (no libssl.so.1.1),
  // but Prisma's default "native" musl engine target was built against
  // OpenSSL 1.1 — without this explicit target, the built image fails at
  // runtime with "Error loading shared library libssl.so.1.1: No such
  // file or directory". "native" is kept too for local dev on other OSes.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// workplace_type and extraction_method are plain TEXT columns with a
// CHECK constraint in db/migrations/0001_init.sql (not native Postgres
// enums), so they're modeled as String here to match the actual column
// type Prisma's query engine will see.
model Job {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupKey         String    @unique @map("dedup_key")
  title            String
  company          String
  location         String?
  workplaceType    String    @default("unknown") @map("workplace_type")
  salaryMin        Decimal?  @map("salary_min")
  salaryMax        Decimal?  @map("salary_max")
  salaryCurrency   String?   @map("salary_currency")
  source           String
  sourceUrl        String    @map("source_url")
  description      String?
  formattedDescription String? @map("formatted_description")
  highlights       String[]  @default([])
  tags             String[]  @default([])
  postedAt         DateTime? @map("posted_at")
  deadlineAt       DateTime? @map("deadline_at")
  logoUrl          String?   @map("logo_url")
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at")
  lastScrapedAt    DateTime  @default(now()) @map("last_scraped_at")
  isActive         Boolean   @default(true) @map("is_active")
  extractionMethod String    @default("deterministic") @map("extraction_method")
  // Structured on Himalayas postings (see db/migrations/0017); other
  // sources leave these null rather than guessing from free text.
  employmentType   String?   @map("employment_type")
  seniority        String?
  raw              Json?
  // Postgres-computed (GENERATED ALWAYS ... STORED, see
  // db/migrations/0014_add_job_quality_score.sql) — never written by
  // Prisma, purely read. Demotes thin/suspicious postings and rewards
  // complete ones (salary/logo/deadline/tags/description length) without
  // ever deleting anything.
  //
  // DRIFT WARNING: Prisma has no way to express a Postgres GENERATED
  // ALWAYS ... STORED column, so this is declared as a plain Int here —
  // that's a deliberate lie to keep Prisma read-only on this field, NOT
  // the real column definition. NEVER run `prisma db push` or
  // `prisma migrate dev` against this database: either would try to
  // reconcile this into an actual plain integer column and silently drop
  // the generated expression, permanently breaking the score. Only
  // hand-written SQL migrations (db/migrations/) may touch this column.
  // The @@index below also doesn't match the real index's direction
  // (Postgres: DESC, via db/migrations/0014) — Prisma's schema syntax has
  // no way to declare index sort order, so this is ASC-by-default and
  // exists only so `prisma db pull` doesn't flag it as unmanaged; it does
  // not describe the real index and must not be trusted for query planning.
  qualityScore     Int       @default(0) @map("quality_score")
  // Last time /api/admin/link-health verified sourceUrl was reachable —
  // NULL means never checked. See db/migrations/0015_add_job_link_checked_at.sql.
  linkCheckedAt    DateTime? @map("link_checked_at")

  // v2 feed layer (services/scraper/feeds), additive-only — see
  // db/migrations/0022-0024. All nullable: v1 rows never set these. For
  // feed sources the board page (sourceUrl) and the application form
  // (applyUrl) are different URLs; applyUrl is the one that matters to a
  // candidate. externalId is the ATS's own posting id, scoped per source
  // (unique together, see idx_jobs_source_external).
  applyUrl         String?   @map("apply_url")
  externalId       String?   @map("external_id")
  companyId        BigInt?   @map("company_id")
  companyRegistry  CompanyRegistry? @relation(fields: [companyId], references: [id])

  // Derived at ingest (services/scraper/utils/field_enrichment.py), read-only
  // from the app's side. See db/migrations/0019.
  minYearsExp      Decimal?  @map("min_years_exp")
  maxYearsExp      Decimal?  @map("max_years_exp")
  experienceBand   String?   @map("experience_band")
  expSource        String?   @map("exp_source")
  tagsNorm         String[]  @default([]) @map("tags_norm")
  fieldProvenance  Json      @default("{}") @map("field_provenance")
  enrichedAt       DateTime? @map("enriched_at")
  enrichmentHash   String?   @map("enrichment_hash")

  // SAME DRIFT WARNING AS qualityScore: this is a Postgres GENERATED ALWAYS
  // ... STORED column that Prisma has no syntax for. Declared as a plain Int
  // to keep Prisma read-only on it. NEVER run `prisma db push` or
  // `prisma migrate dev` against this database — either would reconcile this
  // into a real integer column and silently drop the generated expression.
  fresherRank      Int       @default(2) @map("fresher_rank")

  @@index([source])
  @@index([location])
  @@index([postedAt])
  @@index([tags], type: Gin)
  @@index([isActive, postedAt])
  @@index([qualityScore])
  @@index([experienceBand])
  @@index([tagsNorm], type: Gin)
  @@map("jobs")
}

// v2 feed layer (services/scraper/feeds) — maps a company to its hiring-
// software board (Greenhouse/Lever/Ashby/...) so the feed connectors know
// which public JSON endpoint to poll. See db/migrations/0022_company_registry.sql.
// Written only by services/scraper (seed_registry.py / detect_ats.py); read
// here for admin UI and for the Job.companyRegistry relation.
model CompanyRegistry {
  id           BigInt   @id @default(autoincrement())
  name         String
  slug         String   @unique
  atsProvider  String   @map("ats_provider")
  atsToken     String   @map("ats_token")
  careersUrl   String?  @map("careers_url")
  countryHint  String   @default("IN") @map("country_hint")
  tier         Int      @default(2) @db.SmallInt
  isActive     Boolean  @default(true) @map("is_active")
  lastOkAt     DateTime? @map("last_ok_at")
  lastError    String?  @map("last_error")
  failStreak   Int      @default(0) @map("fail_streak")
  etag         String?
  lastModified String?  @map("last_modified")
  createdAt    DateTime @default(now()) @map("created_at")

  jobs Job[]

  @@unique([atsProvider, atsToken])
  @@map("company_registry")
}

// Contest/hackathon listings sourced from public RSS/JSON feeds (Devpost's
// public API, DEV Community's tag RSS) — a separate table from `jobs`
// rather than a shared polymorphic one, since the two have little schema
// overlap (prize vs. salary, deadline-driven vs. posted-driven) and no
// shared query patterns on the frontend.
model Contest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupKey         String    @unique @map("dedup_key")
  title            String
  platform         String
  organizer        String?
  mode             String    @default("unknown")
  prizeAmount      Decimal?  @map("prize_amount")
  prizeCurrency    String?   @map("prize_currency")
  prizeSummary     String?   @map("prize_summary")
  source           String
  sourceUrl        String    @map("source_url")
  description      String?
  summary          String?
  highlights       String[]  @default([])
  tags             String[]  @default([])
  startsAt         DateTime? @map("starts_at")
  deadlineAt       DateTime? @map("deadline_at")
  logoUrl          String?   @map("logo_url")
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at")
  lastScrapedAt    DateTime  @default(now()) @map("last_scraped_at")
  isActive         Boolean   @default(true) @map("is_active")
  extractionMethod String    @default("deterministic") @map("extraction_method")
  raw              Json?

  @@index([source])
  @@index([deadlineAt])
  @@index([tags], type: Gin)
  @@index([isActive, deadlineAt])
  @@map("contests")
}

// Records every keyword a user searches for, so past searches can be
// surfaced as quick-access links (see StreamsPanel's "Recent searches")
// instead of being forgotten after one visit.
model SearchQuery {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  query           String   @unique
  searchCount     Int      @default(1) @map("search_count")
  firstSearchedAt DateTime @default(now()) @map("first_searched_at")
  lastSearchedAt  DateTime @default(now()) @map("last_searched_at")

  @@index([lastSearchedAt])
  @@map("search_queries")
}

// Scraper source enable/disable + last-error visibility for the admin
// panel — a cross-language-shared config table, same pattern as
// SearchQuery: the Python scheduler reads/writes this same Postgres table
// via psycopg (see services/scraper/db/repository.py), Next.js reads/
// writes it via Prisma directly. Job/Contest rows themselves are untouched
// by this — this is purely "should this source run at all right now."
model ScraperSource {
  name        String    @id
  family      String
  enabled     Boolean   @default(true)
  lastError   String?   @map("last_error")
  lastErrorAt DateTime? @map("last_error_at")

  @@map("scraper_sources")
}

// Outbound-post tracking, shared with the n8n dispatch workflows. One row
// per (contentType, contentId, platform); a row exists only once a send has
// been confirmed-or-attempted. "Pending for platform X" = active job/contest
// with no telegram row yet, or a row whose postedAt is null (failed send,
// retried next poll). Generalizes to whatsapp/instagram/youtube with no
// schema change — same cross-language-shared-table pattern as ScraperSource.
// No FK to jobs/contests: contentId is a bare UUID matching either table's id,
// so this one flat table covers both content types.
model DispatchLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentType String    @map("content_type")
  contentId   String    @map("content_id") @db.Uuid
  platform    String
  postedAt    DateTime? @map("posted_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([contentType, contentId, platform])
  @@index([platform, contentType, contentId])
  @@map("dispatch_log")
}

// First-party traffic analytics (db/migrations/0021), written here, read by
// apps/admin's GET /api/analytics. traffic_source is deliberately NOT
// jobs.source: that column is the scraper origin (internal-only), this one
// is where the VISITOR came from (instagram, google, direct).
model PageView {
  id            BigInt   @id @default(autoincrement())
  visitorId     String   @map("visitor_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  path          String
  referrer      String?
  trafficSource String   @default("direct") @map("traffic_source")
  utmMedium     String?  @map("utm_medium")
  utmCampaign   String?  @map("utm_campaign")
  device        String?
  country       String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([trafficSource, createdAt(sort: Desc)])
  @@index([visitorId])
  @@map("page_view")
}

// content_type/content_id mirrors DispatchLog's convention, so contest
// clicks are covered by the same table with no schema change.
model ApplyClick {
  id            BigInt   @id @default(autoincrement())
  visitorId     String   @map("visitor_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  contentType   String   @map("content_type")
  contentId     String   @map("content_id") @db.Uuid
  trafficSource String   @default("direct") @map("traffic_source")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([trafficSource, createdAt(sort: Desc)])
  @@index([visitorId])
  @@index([contentType, contentId])
  @@map("apply_click")
}

// Self-growing skill vocabulary (migration 0020) — replaces the hardcoded
// dict that used to live twice (services/scraper/utils/skill_vocab.py for
// the writer, this app's skillVocab.ts for the reader). Both sides now read
// these same tables, grown by services/scraper/scripts/mine_skills.py from
// scraped descriptions and from skill searches that returned nothing (see
// SkillQueryMiss). See db/migrations/0020's scope-guard comment: skills
// only, never designations/employment types/locations/degrees.
model Skill {
  canonical       String       @id
  normalized      String       @unique
  origin          String       @default("seed")
  status          String       @default("active")
  ambiguous       Boolean      @default(false)
  contextRequired String[]     @default([]) @map("context_required")
  createdAt       DateTime     @default(now()) @map("created_at")
  aliases         SkillAlias[]

  @@map("skills")
}

model SkillAlias {
  normalized String   @id
  display    String
  canonical  String
  origin     String   @default("seed")
  createdAt  DateTime @default(now()) @map("created_at")
  skill      Skill    @relation(fields: [canonical], references: [canonical], onDelete: Cascade)

  @@index([canonical])
  @@map("skill_aliases")
}

// Zero-result skill searches — the highest-signal input the miner has. See
// apps/web/src/lib/skillVocab.ts::recordSkillMisses.
model SkillQueryMiss {
  normalized  String   @id
  display     String
  missCount   Int      @default(1) @map("miss_count")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  @@map("skill_query_misses")
}

// Hand-curated certification catalogue (db/migrations/0032). Deliberately
// has no scraper/scheduler behind it — small, slow-changing, human-picked.
// Public visibility requires BOTH publishStatus='published' and a human
// having verified the price/URL, so a seeded row can never go live unread.
model Certification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String    @unique
  title           String
  provider        String
  providerSlug    String    @map("provider_slug")
  providerLogoUrl String?   @map("provider_logo_url")
  summary         String?
  description     String?
  highlights      String[]  @default([])
  category        String
  tags            String[]  @default([])
  level           String    @default("beginner")
  priceType       String    @default("free") @map("price_type")
  priceAmount     Decimal?  @map("price_amount")
  priceCurrency   String?   @default("INR") @map("price_currency")
  durationHours   Int?      @map("duration_hours")
  // Always read via `affiliateUrl ?? url` — see partnerLink in
  // src/lib/certificationQuery.ts. Never render `url` directly once an
  // affiliate link exists, or the click earns nothing.
  url             String
  affiliateUrl    String?   @map("affiliate_url")
  affiliateNetwork String?  @map("affiliate_network")
  publishStatus   String    @default("draft") @map("publish_status")
  publishedAt     DateTime? @map("published_at")
  verifiedAt      DateTime? @map("verified_at")
  verifiedBy      String?   @map("verified_by")
  isFeatured      Boolean   @default(false) @map("is_featured")
  displayOrder    Int       @default(100) @map("display_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  partnerClicks   PartnerClick[]

  @@index([publishStatus, displayOrder, createdAt(sort: Desc)])
  @@index([category])
  @@index([priceType])
  @@index([providerSlug])
  @@index([tags], type: Gin)
  @@index([verifiedAt])
  @@map("certifications")
}

// Separate from ApplyClick on purpose: mixing monetised partner clicks into
// the job/contest engagement numbers would quietly corrupt the admin
// analytics dashboard. Also the evidence used when negotiating rates.
model PartnerClick {
  id               BigInt   @id @default(autoincrement())
  visitorId        String   @map("visitor_id") @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  certificationId  String   @map("certification_id") @db.Uuid
  providerSlug     String   @map("provider_slug")
  affiliateNetwork String?  @map("affiliate_network")
  isMonetised      Boolean  @default(false) @map("is_monetised")
  trafficSource    String   @default("direct") @map("traffic_source")
  createdAt        DateTime @default(now()) @map("created_at")

  certification    Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([certificationId, createdAt(sort: Desc)])
  @@index([providerSlug, createdAt(sort: Desc)])
  @@index([trafficSource, createdAt(sort: Desc)])
  @@map("partner_click")
}
