generator client {
  provider      = "prisma-client-js"
  // Same OpenSSL-3-vs-1.1 musl mismatch as apps/web/prisma/schema.prisma —
  // see that file's comment.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Same tables as apps/web/prisma/schema.prisma — this is a second,
// independently generated Prisma client pointed at the exact same
// Postgres database, not a shared package (this project isn't an npm
// workspace). Only the 3 models the admin panel actually touches are
// defined here; apps/web's SearchQuery model isn't needed.
model Job {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupKey         String    @unique @map("dedup_key")
  title            String
  company          String
  location         String?
  workplaceType    String    @default("unknown") @map("workplace_type")
  salaryMin        Decimal?  @map("salary_min")
  salaryMax        Decimal?  @map("salary_max")
  salaryCurrency   String?   @map("salary_currency")
  source           String
  sourceUrl        String    @map("source_url")
  description      String?
  formattedDescription String? @map("formatted_description")
  highlights       String[]  @default([])
  tags             String[]  @default([])
  postedAt         DateTime? @map("posted_at")
  deadlineAt       DateTime? @map("deadline_at")
  logoUrl          String?   @map("logo_url")
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at")
  lastScrapedAt    DateTime  @default(now()) @map("last_scraped_at")
  isActive         Boolean   @default(true) @map("is_active")
  extractionMethod String    @default("deterministic") @map("extraction_method")
  // Structured on Himalayas postings only (see db/migrations/0017); other
  // sources leave these null. Mirrors apps/web's schema — added here so the
  // admin job detail page can show the same fields the public site does.
  employmentType   String?   @map("employment_type")
  seniority        String?
  raw              Json?
  // Derived at ingest (services/scraper/utils/field_enrichment.py), read-only
  // from the app's side. See db/migrations/0019.
  minYearsExp      Decimal?  @map("min_years_exp")
  maxYearsExp      Decimal?  @map("max_years_exp")
  experienceBand   String?   @map("experience_band")
  expSource        String?   @map("exp_source")
  tagsNorm         String[]  @default([]) @map("tags_norm")
  fieldProvenance  Json      @default("{}") @map("field_provenance")
  enrichedAt       DateTime? @map("enriched_at")
  enrichmentHash   String?   @map("enrichment_hash")

  // v2 feed layer (services/scraper/feeds), additive-only — see
  // db/migrations/0022-0024. Mirrors apps/web's schema. All nullable: v1
  // rows never set these.
  applyUrl         String?   @map("apply_url")
  externalId       String?   @map("external_id")
  companyId        BigInt?   @map("company_id")
  companyRegistry  CompanyRegistry? @relation(fields: [companyId], references: [id])

  @@index([source])
  @@index([location])
  @@index([postedAt])
  @@index([tags], type: Gin)
  @@index([isActive, postedAt])
  @@index([experienceBand])
  @@index([tagsNorm], type: Gin)
  @@map("jobs")
}

// v2 feed layer (services/scraper/feeds) — mirrors apps/web's schema. See
// db/migrations/0022_company_registry.sql. Read-only from the admin UI for
// now (enable/disable toggling reuses the existing scraper_sources table,
// per-provider, not per-company).
model CompanyRegistry {
  id           BigInt   @id @default(autoincrement())
  name         String
  slug         String   @unique
  atsProvider  String   @map("ats_provider")
  atsToken     String   @map("ats_token")
  careersUrl   String?  @map("careers_url")
  countryHint  String   @default("IN") @map("country_hint")
  tier         Int      @default(2) @db.SmallInt
  isActive     Boolean  @default(true) @map("is_active")
  lastOkAt     DateTime? @map("last_ok_at")
  lastError    String?  @map("last_error")
  failStreak   Int      @default(0) @map("fail_streak")
  etag         String?
  lastModified String?  @map("last_modified")
  createdAt    DateTime @default(now()) @map("created_at")

  jobs Job[]

  @@unique([atsProvider, atsToken])
  @@map("company_registry")
}

model Contest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupKey         String    @unique @map("dedup_key")
  title            String
  platform         String
  organizer        String?
  mode             String    @default("unknown")
  prizeAmount      Decimal?  @map("prize_amount")
  prizeCurrency    String?   @map("prize_currency")
  prizeSummary     String?   @map("prize_summary")
  source           String
  sourceUrl        String    @map("source_url")
  description      String?
  summary          String?
  highlights       String[]  @default([])
  tags             String[]  @default([])
  startsAt         DateTime? @map("starts_at")
  deadlineAt       DateTime? @map("deadline_at")
  logoUrl          String?   @map("logo_url")
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at")
  lastScrapedAt    DateTime  @default(now()) @map("last_scraped_at")
  isActive         Boolean   @default(true) @map("is_active")
  extractionMethod String    @default("deterministic") @map("extraction_method")
  raw              Json?

  @@index([source])
  @@index([deadlineAt])
  @@index([tags], type: Gin)
  @@index([isActive, deadlineAt])
  @@map("contests")
}

model ScraperSource {
  name        String    @id
  family      String
  enabled     Boolean   @default(true)
  lastError   String?   @map("last_error")
  lastErrorAt DateTime? @map("last_error_at")

  @@map("scraper_sources")
}

// Write-only trail of destructive/mutating admin actions — see writeAuditLog
// in lib/auditLog.ts for the one place rows get inserted.
model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminEmail String   @map("admin_email")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_audit_log")
}

// First-party traffic analytics (db/migrations/0021) — apps/web writes,
// this app reads via GET /api/analytics. traffic_source is deliberately NOT
// jobs.source: that column is the scraper origin (internal-only), this one
// is where the VISITOR came from (instagram, google, direct).
model PageView {
  id            BigInt   @id @default(autoincrement())
  visitorId     String   @map("visitor_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  path          String
  referrer      String?
  trafficSource String   @default("direct") @map("traffic_source")
  utmMedium     String?  @map("utm_medium")
  utmCampaign   String?  @map("utm_campaign")
  device        String?
  country       String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([trafficSource, createdAt(sort: Desc)])
  @@index([visitorId])
  @@map("page_view")
}

// content_type/content_id mirrors DispatchLog's convention, so contest
// clicks are covered by the same table with no schema change.
model ApplyClick {
  id            BigInt   @id @default(autoincrement())
  visitorId     String   @map("visitor_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  contentType   String   @map("content_type")
  contentId     String   @map("content_id") @db.Uuid
  trafficSource String   @default("direct") @map("traffic_source")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([trafficSource, createdAt(sort: Desc)])
  @@index([visitorId])
  @@index([contentType, contentId])
  @@map("apply_click")
}

// Hand-curated certification catalogue (db/migrations/0032). Deliberately
// has no scraper/scheduler behind it — small, slow-changing, human-picked.
// Public visibility requires BOTH publishStatus='published' and a human
// having verified the price/URL, so a seeded row can never go live unread.
model Certification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String    @unique
  title           String
  provider        String
  providerSlug    String    @map("provider_slug")
  providerLogoUrl String?   @map("provider_logo_url")
  summary         String?
  description     String?
  highlights      String[]  @default([])
  category        String
  tags            String[]  @default([])
  level           String    @default("beginner")
  priceType       String    @default("free") @map("price_type")
  priceAmount     Decimal?  @map("price_amount")
  priceCurrency   String?   @default("INR") @map("price_currency")
  durationHours   Int?      @map("duration_hours")
  // Always read via `affiliateUrl ?? url` — see partnerLink in
  // src/lib/certificationQuery.ts. Never render `url` directly once an
  // affiliate link exists, or the click earns nothing.
  url             String
  affiliateUrl    String?   @map("affiliate_url")
  affiliateNetwork String?  @map("affiliate_network")
  publishStatus   String    @default("draft") @map("publish_status")
  publishedAt     DateTime? @map("published_at")
  verifiedAt      DateTime? @map("verified_at")
  verifiedBy      String?   @map("verified_by")
  isFeatured      Boolean   @default(false) @map("is_featured")
  displayOrder    Int       @default(100) @map("display_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  partnerClicks   PartnerClick[]

  @@index([publishStatus, displayOrder, createdAt(sort: Desc)])
  @@index([category])
  @@index([priceType])
  @@index([providerSlug])
  @@index([tags], type: Gin)
  @@index([verifiedAt])
  @@map("certifications")
}

// Separate from ApplyClick on purpose: mixing monetised partner clicks into
// the job/contest engagement numbers would quietly corrupt the admin
// analytics dashboard. Also the evidence used when negotiating rates.
model PartnerClick {
  id               BigInt   @id @default(autoincrement())
  visitorId        String   @map("visitor_id") @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  certificationId  String   @map("certification_id") @db.Uuid
  providerSlug     String   @map("provider_slug")
  affiliateNetwork String?  @map("affiliate_network")
  isMonetised      Boolean  @default(false) @map("is_monetised")
  trafficSource    String   @default("direct") @map("traffic_source")
  createdAt        DateTime @default(now()) @map("created_at")

  certification    Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([certificationId, createdAt(sort: Desc)])
  @@index([providerSlug, createdAt(sort: Desc)])
  @@index([trafficSource, createdAt(sort: Desc)])
  @@map("partner_click")
}
