generator client {
  provider      = "prisma-client-js"
  // Same OpenSSL-3-vs-1.1 musl mismatch as apps/web/prisma/schema.prisma —
  // see that file's comment.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Same tables as apps/web/prisma/schema.prisma — this is a second,
// independently generated Prisma client pointed at the exact same
// Postgres database, not a shared package (this project isn't an npm
// workspace). Only the 3 models the admin panel actually touches are
// defined here; apps/web's SearchQuery model isn't needed.
model Job {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupKey         String    @unique @map("dedup_key")
  title            String
  company          String
  location         String?
  workplaceType    String    @default("unknown") @map("workplace_type")
  salaryMin        Decimal?  @map("salary_min")
  salaryMax        Decimal?  @map("salary_max")
  salaryCurrency   String?   @map("salary_currency")
  source           String
  sourceUrl        String    @map("source_url")
  description      String?
  formattedDescription String? @map("formatted_description")
  highlights       String[]  @default([])
  tags             String[]  @default([])
  postedAt         DateTime? @map("posted_at")
  deadlineAt       DateTime? @map("deadline_at")
  logoUrl          String?   @map("logo_url")
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at")
  lastScrapedAt    DateTime  @default(now()) @map("last_scraped_at")
  isActive         Boolean   @default(true) @map("is_active")
  extractionMethod String    @default("deterministic") @map("extraction_method")
  // Structured on Himalayas postings only (see db/migrations/0017); other
  // sources leave these null. Mirrors apps/web's schema — added here so the
  // admin job detail page can show the same fields the public site does.
  employmentType   String?   @map("employment_type")
  seniority        String?
  raw              Json?
  // Derived at ingest (services/scraper/utils/field_enrichment.py), read-only
  // from the app's side. See db/migrations/0019.
  minYearsExp      Decimal?  @map("min_years_exp")
  maxYearsExp      Decimal?  @map("max_years_exp")
  experienceBand   String?   @map("experience_band")
  expSource        String?   @map("exp_source")
  tagsNorm         String[]  @default([]) @map("tags_norm")
  fieldProvenance  Json      @default("{}") @map("field_provenance")
  enrichedAt       DateTime? @map("enriched_at")
  enrichmentHash   String?   @map("enrichment_hash")

  @@index([source])
  @@index([location])
  @@index([postedAt])
  @@index([tags], type: Gin)
  @@index([isActive, postedAt])
  @@index([experienceBand])
  @@index([tagsNorm], type: Gin)
  @@map("jobs")
}

model Contest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupKey         String    @unique @map("dedup_key")
  title            String
  platform         String
  organizer        String?
  mode             String    @default("unknown")
  prizeAmount      Decimal?  @map("prize_amount")
  prizeCurrency    String?   @map("prize_currency")
  prizeSummary     String?   @map("prize_summary")
  source           String
  sourceUrl        String    @map("source_url")
  description      String?
  summary          String?
  highlights       String[]  @default([])
  tags             String[]  @default([])
  startsAt         DateTime? @map("starts_at")
  deadlineAt       DateTime? @map("deadline_at")
  logoUrl          String?   @map("logo_url")
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at")
  lastScrapedAt    DateTime  @default(now()) @map("last_scraped_at")
  isActive         Boolean   @default(true) @map("is_active")
  extractionMethod String    @default("deterministic") @map("extraction_method")
  raw              Json?

  @@index([source])
  @@index([deadlineAt])
  @@index([tags], type: Gin)
  @@index([isActive, deadlineAt])
  @@map("contests")
}

model ScraperSource {
  name        String    @id
  family      String
  enabled     Boolean   @default(true)
  lastError   String?   @map("last_error")
  lastErrorAt DateTime? @map("last_error_at")

  @@map("scraper_sources")
}

// Write-only trail of destructive/mutating admin actions — see writeAuditLog
// in lib/auditLog.ts for the one place rows get inserted.
model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminEmail String   @map("admin_email")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_audit_log")
}

// First-party traffic analytics (db/migrations/0021) — apps/web writes,
// this app reads via GET /api/analytics. traffic_source is deliberately NOT
// jobs.source: that column is the scraper origin (internal-only), this one
// is where the VISITOR came from (instagram, google, direct).
model PageView {
  id            BigInt   @id @default(autoincrement())
  visitorId     String   @map("visitor_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  path          String
  referrer      String?
  trafficSource String   @default("direct") @map("traffic_source")
  utmMedium     String?  @map("utm_medium")
  utmCampaign   String?  @map("utm_campaign")
  device        String?
  country       String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([trafficSource, createdAt(sort: Desc)])
  @@index([visitorId])
  @@map("page_view")
}

// content_type/content_id mirrors DispatchLog's convention, so contest
// clicks are covered by the same table with no schema change.
model ApplyClick {
  id            BigInt   @id @default(autoincrement())
  visitorId     String   @map("visitor_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  contentType   String   @map("content_type")
  contentId     String   @map("content_id") @db.Uuid
  trafficSource String   @default("direct") @map("traffic_source")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([trafficSource, createdAt(sort: Desc)])
  @@index([visitorId])
  @@index([contentType, contentId])
  @@map("apply_click")
}
