ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_portal

# Optional — self-hosted FreeLLMAPI (https://github.com/tashfeenahmed/freellmapi),
# tried first in the LLM fallback path (see scrapers/llm_fallback.py) before the
# direct Gemini/Anthropic/OpenAI calls above. No billing needed for any of its
# ~29 aggregated free-tier providers. Leave both unset to skip it entirely.
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=

# Optional — v2 feed layer (services/scraper/feeds). Sent as the User-Agent
# on every ATS board-API request; defaults to a sensible value (see
# feeds/feed_http.py) if left unset. Public, unauthenticated APIs — no key
# needed for Greenhouse.
FEED_USER_AGENT=

# Optional — Stage 7 tiered polling cadence (feed_scheduler.py). All have
# sensible defaults; override only to tune. Tier 1 = hottest companies
# (auto-promoted by apply-click volume), tier 2 = the middle, tier 3 = daily
# long tail. The 15-min tier-1 cadence is only affordable because ~95% of
# those requests come back as a free 304 Not Modified (conditional GET).
FEED_TIER1_INTERVAL_MIN=15
FEED_TIER2_INTERVAL_MIN=60
# Daily auto-tiering: the top-N most-apply-clicked companies (over the last
# N days) become tier 1.
FEED_PROMOTE_TOP_N=50
FEED_PROMOTE_WINDOW_DAYS=14

# Optional — Stage 5 aggregator API keys (all free tiers). Each connector
# self-skips with a "skipped" log if its key is unset, so leaving these
# blank just disables that aggregator. Query-driven, daily-only, and their
# apply links are indirect (redirect through the aggregator) so their
# postings are flagged and rank below direct ATS jobs (db/migrations/0026).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_AFFID=
